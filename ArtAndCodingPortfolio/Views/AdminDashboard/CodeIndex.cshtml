@using ArtAndCodingPortfolio.Models
@model IEnumerable<CodeProject>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h3>Code Projects <a asp-action="AddCodeProject" class="btn btn-primary">Add Code Project</a></h3>

@if (!Model.Any())
{
    <p>No Code Projects Yet</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Sort</th>
                <th>Hidden</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CodeProject project in Model)
            {
                <tr>
                    <td>@project.Title</td>
                    <td>@project.SortOrder</td>
                    <td>@(project.IsHidden ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="EditCode" asp-route-id="@project.CodeProjectID" class="btn btn-sm btn-outline-primary">Edit</a>

                        <a asp-action="DeleteCode" asp-route-id="@project.CodeProjectID" class="btn btn-sm btn-outline-danger">Delete</a>
                        
                        @if (project.IsHidden)
                        {
                            <form asp-action="UnhideCode" asp-route-id="@project.CodeProjectID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Unhide</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="HideCode" asp-route-id="@project.CodeProjectID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Hide</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}