<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - ArtAndCodingPortfolio</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ArtAndCodingPortfolio.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-weight: 500">Art & Coding Portfolio</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index" style="font-weight: 600">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Art" asp-action="Index" style="font-weight: 600">Art</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Code" asp-action="Index" style="font-weight: 600">Code</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Contact" asp-action="Index" style="font-weight: 600">Contact</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Privacy" asp-action="Index" style="font-weight: 600">Privacy</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="UserAgreement" asp-action="Index" style="font-weight: 600">User Agreement</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (Context.Session.GetString("IsAdmin") == "true"){
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="AdminDashboard" asp-action="Index">ArtAdmin</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="AdminDashboard" asp-action="CodeIndex">CodeAdmin</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Art&CodingPortfolio - <a asp-controller="Privacy" asp-action="Index">Privacy</a> <a asp-controller="UserAgreement" asp-action="Index">User Agreement</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>