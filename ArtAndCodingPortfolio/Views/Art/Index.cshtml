@model IEnumerable<ArtPiece>

@{
    ViewData["Title"] = "Art";
    Layout = "_Layout";
}
<h2>@ViewData["Title"]</h2>

<table class="table">
    <tr>
        <th>Image</th>
        <th>Title</th>
        <th>Description</th>
        <th>Date Added</th>
    </tr>
    
    @foreach (var art in Model)
    {
        <tr>
            <td><img src="@art.ImagePath" height="333px" width="325px" alt=""></td>
            <td>@art.Title</td>
            <td>@art.Description</td>
            <td>@art.DateAdded</td>
        </tr>
    }
</table>