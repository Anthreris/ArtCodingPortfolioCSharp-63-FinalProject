@model IEnumerable<ArtAndCodingPortfolio.Models.CodeProject>

@{
    ViewData["Title"] = "Code";
    Layout = "_Layout";
}
<h2>@ViewData["Title"]</h2>

<table class="table">
    <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Tech Stack</th>
        <th>GitHub</th>
        <th>Date Added</th>
    </tr>
    
    @foreach (CodeProject project in Model)
    {
        <tr>
            <td>@project.Title</td>
            <td>@project.Description</td>
            <td>@project.TechStack</td>
            <td>
                @if (!string.IsNullOrEmpty(project.GitHubUrl))
                {
                    <a href="@project.GitHubUrl" target="_blank">view repo</a>
                }
            </td>
            <td>
                @project.DateAdded.ToShortDateString()
            </td>
        </tr>
    }
</table>